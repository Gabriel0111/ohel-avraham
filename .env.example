# The backend runs on Convex, not on Vercel — so the variables are split across
# two environments. Setting a Convex secret in Vercel does nothing, and vice
# versa. This file covers local development, where a single .env feeds both.

# ─── Read by the Next.js app (in production: set these in Vercel) ─────────────

# Convex deployment, API endpoint. In production this one is injected
# automatically by `npx convex deploy --cmd 'pnpm build'` — no need to set it.
NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud

# Convex deployment, HTTP endpoint (Better Auth routes live here). NOT injected
# automatically — set it in Vercel by hand.
NEXT_PUBLIC_CONVEX_SITE_URL=https://<deployment>.convex.site

# Canonical origin, no trailing slash. metadataBase, robots.txt and sitemap.xml
# are baked at build time, so this must be set BEFORE the Vercel build or all
# three will point at localhost.
SITE_URL=http://localhost:3000

# Google Maps — two distinct keys, deliberately.
#   Public one: browser only (Maps JavaScript API). Ships in the client bundle,
#   so restrict it by HTTP referrer in the Google console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
#   Server one: used by the /api/places routes. A request from Vercel carries no
#   referrer, so a referrer-restricted key would be rejected here — restrict this
#   one to the Places API instead, and never expose it to the client.
GOOGLE_MAPS_API_KEY=

# ─── Read by Convex (in production: `npx convex env set … --prod`) ────────────
# These never belong in Vercel. Convex reads them from its own environment.

CONVEX_DEPLOYMENT=

# Better Auth. Generate a fresh one for production: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth. The authorised redirect URI points at Convex, not at your
# domain: https://<deployment>.convex.site/api/auth/callback/google
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Resend. The sending domain (mail.<your-domain>) must be verified with SPF and
# DKIM, or every email fails silently.
RESEND_API_KEY=

# Convex also reads SITE_URL — it is Better Auth's baseURL and builds every
# callback URL and email link. Set it in BOTH environments.
